{
  "name": "verifyfirst-extension",
  "version": "0.1.0",
  "private": true,
  "description": "VerifyFirst Chrome Extension",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "release:check": "node ../scripts/release_check.mjs",
    "release": "node ../scripts/build.mjs && npm run release:check && node ../scripts/zip.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "jsdom": "^29.1.1",
    "typescript": "^5.0.0"
  }
}

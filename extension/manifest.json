{
  "manifest_version": 3,
  "name": "VerifyFirst Security",
  "version": "0.2.0",
  "description": "Detect suspicious links before you click them.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "content/security-center/securityCenter.css"
      ],
      "js": [
        "content/verifyFirstOverlay.js",
        "content/protection/types.js",
        "content/protection/action.js",
        "content/protection/navigationGuard.js",
        "content/whatsappScanner.js",
        "content/security-center/securityCenter.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "content/security-center/securityCenter.css",
        "shared/telemetryClient.js"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ]
}

